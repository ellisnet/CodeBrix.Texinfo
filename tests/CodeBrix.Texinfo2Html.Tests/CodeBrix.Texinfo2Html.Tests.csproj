<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.164.180" />
    <!--
      No SkiaSharp native-assets package is referenced here on purpose. CodeBrix.Texinfo2Html
      only emits HTML and CSS - it never rasterizes anything, so it never touches SkiaSharp.
      The Linux native-assets requirement belongs to CodeBrix.PdfDocCreate.Html2Pdf, which
      CodeBrix.Texinfo2Pdf references; see that project's .Tests .csproj.
    -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.Texinfo2Html\CodeBrix.Texinfo2Html.csproj" />
  </ItemGroup>

</Project>
